<?xml version='1.0' encoding='utf-8'?>
<MixxxControllerPreset mixxxVersion="2.4.0" schemaVersion="1">
    <info>
        <name>Native Instruments Traktor Kontrol Z1</name>
        <author>djantti</author>
        <description>HID mapping for Native Instruments Traktor Kontrol Z1</description>
        <forums>https://mixxx.discourse.group/t/new-mapping-for-native-instruments-traktor-kontrol-z1/28436</forums>
        <manual>native_instruments_traktor_kontrol_z1</manual>
        <devices>
            <product protocol="hid" vendor_id="0x17cc" product_id="0x1210" />
        </devices>
    </info>
    <settings>
        <group label="Deck lighting">
            <row orientation="vertical">
                <option
                    variable="activeBrightness"
                    type="enum"
                    label="Active LED brightness">
                    <value label="Off">off</value>
                    <value label="Low">low</value>
                    <value label="Medium">medium</value>
                    <value label="High">high</value>
                    <value label="Max" default="true">max</value>
                    <description>
                        Controls the brightness level of active button LEDs. Switching this off will disable active button light indicators.
                    </description>
                </option>
                <option
                    variable="inactiveBrightness"
                    type="enum"
                    label="Inactive LED brightness">
                    <value label="Off">off</value>
                    <value label="Low" default="true">low</value>
                    <value label="Medium">medium</value>
                    <value label="High">high</value>
                    <value label="Max">max</value>
                    <description>
                        Controls the brightness level of inactive button LEDs. Switching this off will disable inactive button light indicators.
                    </description>
                </option>
                <option
                    variable="vuBrightness"
                    type="enum"
                    label="VU meter brightness">
                    <value label="Off">off</value>
                    <value label="Low">low</value>
                    <value label="Medium">medium</value>
                    <value label="High">high</value>
                    <value label="Max" default="true">max</value>
                    <description>
                        Controls the brightness level of VU meters. Switching this off will disable VU meter LEDs.
                    </description>
                </option>
            </row>
        </group>
        <group label="VU meters">
            <row>
                <option
                    variable="vuDecayFactor"
                    type="enum"
                    label="VU meter LED segment decay">
                    <value label="Instant" default="true">0</value>
                    <value label="Fast">0.4</value>
                    <value label="Slow">0.7</value>
                    <description>
                        Controls the decay speed of VU meter segment LEDs.
                    </description>
                </option>
            </row>
        </group>
        <group label="Calibration">
            <row orientation="vertical">
                <option
                    variable="crossfaderCalibration"
                    type="boolean"
                    default="true"
                    label="Use on-device calibration data">
                    <description>
                        Use calibration values stored in device memory. Enabling this will disable manual calibration overrides.
                    </description>
                </option>
            </row>
            <row>
                <option
                    variable="crossfaderCalibrationLeft"
                    type="integer"
                    min="0"
                    max="2047"
                    step="1"
                    default="0"
                    label="Left crossfader cutoff point">
                    <description>
                        Manual calibration override for left side crossfader cutoff point.
                    </description>
                </option>
                <option
                    variable="crossfaderCalibrationRight"
                    type="integer"
                    min="2048"
                    max="4095"
                    step="1"
                    default="4095"
                    label="Right crossfader cutoff point">
                    <description>
                        Manual calibration override for right side crossfader cutoff point.
                    </description>
                </option>
            </row>
        </group>
    </settings>
    <controller id="Traktor">
        <scriptfiles>
            <file filename="common-hid-packet-parser.js" functionprefix="" />
            <file filename="Traktor-Kontrol-Z1-scripts.js" functionprefix="TraktorZ1" />
        </scriptfiles>
    </controller>
</MixxxControllerPreset>
